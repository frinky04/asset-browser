#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ASSET_BROWSER_VERSION_COMMA@,0
 PRODUCTVERSION @ASSET_BROWSER_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Asset Browser contributors\0"
            VALUE "FileDescription", "Asset Browser\0"
            VALUE "FileVersion", "@ASSET_BROWSER_VERSION@\0"
            VALUE "InternalName", "asset-browser\0"
            VALUE "OriginalFilename", "asset-browser.exe\0"
            VALUE "ProductName", "Asset Browser\0"
            VALUE "ProductVersion", "@ASSET_BROWSER_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
